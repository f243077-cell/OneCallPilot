{
  "$defs": {
    "ContainerState": {
      "additionalProperties": false,
      "description": "State of one container (dry runs and structural health checks).",
      "properties": {
        "health": {
          "enum": [
            "healthy",
            "unhealthy",
            "starting",
            "none"
          ],
          "title": "Health",
          "type": "string"
        },
        "name": {
          "pattern": "^cs-[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "state": {
          "enum": [
            "created",
            "restarting",
            "running",
            "removing",
            "paused",
            "exited",
            "dead"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "name",
        "state",
        "health"
      ],
      "title": "ContainerState",
      "type": "object"
    },
    "DryRunCurrent": {
      "additionalProperties": false,
      "description": "What the runner sees now (§7.5).",
      "properties": {
        "active_release": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null for clear_cache",
          "title": "Active Release"
        },
        "cache_keys": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "clear_cache only",
          "title": "Cache Keys"
        },
        "containers": {
          "items": {
            "$ref": "#/$defs/ContainerState"
          },
          "title": "Containers",
          "type": "array"
        },
        "running_replicas": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "null for clear_cache",
          "title": "Running Replicas"
        }
      },
      "required": [
        "active_release",
        "running_replicas",
        "containers",
        "cache_keys"
      ],
      "title": "DryRunCurrent",
      "type": "object"
    },
    "DryRunPreconditions": {
      "additionalProperties": false,
      "properties": {
        "cooldown_ok": {
          "title": "Cooldown Ok",
          "type": "boolean"
        },
        "rate_limit_ok": {
          "title": "Rate Limit Ok",
          "type": "boolean"
        },
        "slots_available": {
          "title": "Slots Available",
          "type": "boolean"
        }
      },
      "required": [
        "rate_limit_ok",
        "cooldown_ok",
        "slots_available"
      ],
      "title": "DryRunPreconditions",
      "type": "object"
    },
    "DryRunResult": {
      "additionalProperties": false,
      "description": "The runner's preview of an action (RUN-007).",
      "properties": {
        "current": {
          "$ref": "#/$defs/DryRunCurrent"
        },
        "preconditions": {
          "$ref": "#/$defs/DryRunPreconditions"
        },
        "predicted_effect": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Predicted Effect",
          "type": "string"
        },
        "state_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Fingerprint",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "would_change": {
          "items": {
            "$ref": "#/$defs/WouldChange"
          },
          "title": "Would Change",
          "type": "array"
        }
      },
      "required": [
        "would_change",
        "current",
        "preconditions",
        "predicted_effect",
        "warnings",
        "state_fingerprint"
      ],
      "title": "DryRunResult",
      "type": "object"
    },
    "RollbackStep": {
      "additionalProperties": false,
      "description": "The concrete rollback proposal offered if verification fails (C4, FR-015).",
      "properties": {
        "action": {
          "enum": [
            "restart_service",
            "scale_service",
            "rollback_deploy",
            "clear_cache"
          ],
          "title": "Action",
          "type": "string"
        },
        "params": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "action",
        "params"
      ],
      "title": "RollbackStep",
      "type": "object"
    },
    "WouldChange": {
      "additionalProperties": false,
      "description": "One change an action would make: a container, or a cache for ``clear_cache``.",
      "properties": {
        "change": {
          "enum": [
            "start",
            "stop",
            "restart",
            "clear"
          ],
          "title": "Change",
          "type": "string"
        },
        "target": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "change"
      ],
      "title": "WouldChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A proposed catalogue action awaiting a decision (§5.6, §9.3; DB-005).",
  "properties": {
    "action": {
      "enum": [
        "restart_service",
        "scale_service",
        "rollback_deploy",
        "clear_cache"
      ],
      "title": "Action",
      "type": "string"
    },
    "approval_requirement": {
      "enum": [
        "tap",
        "biometric"
      ],
      "title": "Approval Requirement",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dry_run_at": {
      "format": "date-time",
      "title": "Dry Run At",
      "type": "string"
    },
    "dry_run_result": {
      "$ref": "#/$defs/DryRunResult"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^E[0-9]{1,3}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Evidence Refs",
      "type": "array"
    },
    "expected_effect": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Expected Effect",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "fingerprint": {
      "description": "The app echoes it to approve (§7.5)",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "incident_id": {
      "format": "uuid",
      "title": "Incident Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "primary",
        "rollback"
      ],
      "title": "Kind",
      "type": "string"
    },
    "params": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        }
      },
      "title": "Params",
      "type": "object"
    },
    "parent_proposal_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Proposal Id"
    },
    "rationale": {
      "maxLength": 600,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "risk_tier": {
      "description": "Copied from the catalogue, never from the model",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Risk Tier",
      "type": "string"
    },
    "rollback_step": {
      "anyOf": [
        {
          "$ref": "#/$defs/RollbackStep"
        },
        {
          "type": "null"
        }
      ],
      "description": "null = not reversible"
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "superseded",
        "executing",
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "status_reason": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Status Reason"
    }
  },
  "required": [
    "id",
    "incident_id",
    "kind",
    "parent_proposal_id",
    "action",
    "params",
    "risk_tier",
    "approval_requirement",
    "expected_effect",
    "rationale",
    "evidence_refs",
    "rollback_step",
    "dry_run_result",
    "dry_run_at",
    "fingerprint",
    "status",
    "status_reason",
    "expires_at",
    "created_at"
  ],
  "title": "Proposal",
  "type": "object"
}

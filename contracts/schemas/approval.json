        "biometric",
        "tap"
      ],
      "title": "Auth Method",
      "type": "string"
    },
    "challenge_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Challenge Id"
    },
    "decided_at": {

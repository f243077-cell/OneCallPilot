{
  "$defs": {
    "NotifySettings": {
      "additionalProperties": false,
      "properties": {
        "min_push_severity": {
          "enum": [
            "sev1",
            "sev2",
            "sev3"
          ],
          "title": "Min Push Severity",
          "type": "string"
        }
      },
      "required": [
        "min_push_severity"
      ],
      "title": "NotifySettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Body of ``PUT /settings``; ``version`` is the one last read (FR-023, API-013).",
  "properties": {
    "notify": {
      "$ref": "#/$defs/NotifySettings"
    },
    "services": {
      "items": {
        "enum": [
          "api",
          "worker",
          "lb",
          "payments",
          "redis",
          "postgres"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Services",
      "type": "array"
    },
    "thresholds": {
      "patternProperties": {
        "^[a-z0-9_]+(\\.[a-z0-9_]+)*$": {
          "type": "number"
        }
      },
      "title": "Thresholds",
      "type": "object"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "services",
    "thresholds",
    "notify"
  ],
  "title": "MonitorSettingsUpdate",
  "type": "object"
}

{
  "$defs": {
    "Signal": {
      "additionalProperties": false,
      "description": "One detector signal (§6.8), as sent in ``AlertIn`` (§9.2).",
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline"
        },
        "first_anomalous_at": {
          "format": "date-time",
          "title": "First Anomalous At",
          "type": "string"
        },
        "name": {
          "enum": [
            "error_rate",
            "p95_latency",
            "job_failure_rate",
            "restarts",
            "stack_traces"
          ],
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "zscore": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Zscore"
        }
      },
      "required": [
        "name",
        "value",
        "baseline",
        "zscore",
        "first_anomalous_at"
      ],
      "title": "Signal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``kind = detector_signal``: the signal snapshot of the alert (seed evidence).",
  "properties": {
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "service": {
      "enum": [
        "api",
        "worker",
        "lb",
        "payments",
        "redis",
        "postgres"
      ],
      "title": "Service",
      "type": "string"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/Signal"
      },
      "minItems": 1,
      "title": "Signals",
      "type": "array"
    }
  },
  "required": [
    "service",
    "signals",
    "observed_at"
  ],
  "title": "DetectorSignalPayload",
  "type": "object"
}

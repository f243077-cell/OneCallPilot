        "event_id",
        "incident_id",
        "state_version",
        "ts",
        "event",
        "data"
      ],
      "title": "IncidentOpenedEvent",
      "type": "object"
    },
    "IncidentResolvedData": {
      "additionalProperties": false,
      "properties": {
        "resolution": {
          "enum": [
            "action_succeeded",
            "auto_recovered",
            "manual",
            "rolled_back"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "resolved_at": {
          "format": "date-time",
          "title": "Resolved At",
          "type": "string"
        }
      },
      "required": [
        "resolution",
        "resolved_at"
      ],
      "title": "IncidentResolvedData",
      "type": "object"
    },
    "IncidentResolvedEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/IncidentResolvedData"
        },
        "event": {
          "const": "incident.resolved",
          "title": "Event",
          "type": "string"
        },
        "event_id": {
          "pattern": "^[0-9]+-[0-9]+$",
          "title": "Event Id",
          "type": "string"
        },
        "incident_id": {
          "format": "uuid",
          "title": "Incident Id",

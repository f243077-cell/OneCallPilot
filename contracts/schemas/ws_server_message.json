        }
      },
      "required": [
        "type",
        "event_id",
        "incident_id",
        "state_version",
        "ts",
        "event",
        "data"
      ],
      "title": "HypothesisUpdatedEvent",
      "type": "object"
    },
    "IncidentOpenedEvent": {
      "additionalProperties": false,

    "JsonValue": {},
    "Proposal": {
      "additionalProperties": false,
      "description": "A proposed catalogue action awaiting a decision (§5.6, §9.3; DB-005).",
      "properties": {
        "action": {
          "enum": [
            "restart_service",
            "scale_service",
            "rollback_deploy",
            "clear_cache"
          ],
          "title": "Action",
          "type": "string"
        },
        "approval_requirement": {
          "enum": [
            "tap",
            "biometric"
          ],
          "title": "Approval Requirement",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dry_run_at": {
          "format": "date-time",
          "title": "Dry Run At",
          "type": "string"
        },
        "dry_run_result": {
          "$ref": "#/$defs/DryRunResult"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^E[0-9]{1,3}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected_effect": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        },

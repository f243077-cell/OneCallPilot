        },
        "state_version": {
          "description": "The incident's state_version after the change",
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "event",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "event_id",
        "incident_id",
        "state_version",
        "ts",
        "event",
        "data"
      ],
      "title": "IncidentResolvedEvent",
      "type": "object"
    },
    "IncidentSummary": {
      "additionalProperties": false,
      "description": "An incident in the feed (§9.3; DB-002).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "opened_at": {
          "format": "date-time",
          "title": "Opened At",
          "type": "string"
        },
        "pending_proposal_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pending Proposal Id"
        },
        "resolution": {
          "anyOf": [
            {
              "enum": [
                "action_succeeded",
                "auto_recovered",
                "manual",
                "rolled_back"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolution"
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved At"
        },
        "service": {
          "enum": [
            "api",
            "worker",
            "lb",
            "payments",
            "redis",
            "postgres"
          ],
          "title": "Service",
          "type": "string"
        },
        "severity": {
          "enum": [
            "sev1",
            "sev2",
            "sev3"
          ],
          "title": "Severity",
          "type": "string"
        },
        "state_version": {
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "investigating",
            "awaiting_approval",
            "escalated",
            "executing",
            "verifying",
            "resolved",
            "action_failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "status_reason": {
          "anyOf": [
            {
              "enum": [
                "low_confidence",
                "no_catalogue_action_fits",
                "budget_exhausted",
                "llm_unavailable",
                "llm_output_invalid",
                "proposal_invalid",
                "dry_run_unavailable",
                "proposal_rejected",
                "proposal_expired",
                "rolled_back_after_failed_action",
                "runner_refused",
                "runner_timeout",
                "agent_interrupted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Reason"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "top_hypothesis": {
          "anyOf": [
            {
              "$ref": "#/$defs/TopHypothesis"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "service",
        "severity",
        "status",
        "status_reason",
        "title",
        "opened_at",
        "resolved_at",
        "resolution",
        "state_version",
        "top_hypothesis",
        "pending_proposal_id"
      ],
      "title": "IncidentSummary",
      "type": "object"
    },
    "IncidentUpdatedData": {
      "additionalProperties": false,
      "properties": {
        "severity": {

{
  "$defs": {
    "ContainerState": {
      "additionalProperties": false,
      "description": "State of one container (dry runs and structural health checks).",
      "properties": {
        "health": {
          "enum": [
            "healthy",
            "unhealthy",
            "starting",
            "none"
          ],
          "title": "Health",
          "type": "string"
        },
        "name": {
          "pattern": "^cs-[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "state": {
          "enum": [
            "created",
            "restarting",
            "running",
            "removing",
            "paused",
            "exited",
            "dead"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "name",
        "state",
        "health"
      ],
      "title": "ContainerState",
      "type": "object"
    },
    "DryRunCurrent": {
      "additionalProperties": false,
      "description": "What the runner sees now (§7.5).",
      "properties": {
        "active_release": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null for clear_cache",
          "title": "Active Release"
        },
        "cache_keys": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "clear_cache only",
          "title": "Cache Keys"
        },
        "containers": {
          "items": {
            "$ref": "#/$defs/ContainerState"
          },
          "title": "Containers",
          "type": "array"
        },
        "running_replicas": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "null for clear_cache",
          "title": "Running Replicas"
        }
      },
      "required": [
        "active_release",
        "running_replicas",
        "containers",
        "cache_keys"
      ],
      "title": "DryRunCurrent",
      "type": "object"
    },
    "DryRunPreconditions": {
      "additionalProperties": false,
      "properties": {
        "cooldown_ok": {
          "title": "Cooldown Ok",
          "type": "boolean"
        },
        "rate_limit_ok": {
          "title": "Rate Limit Ok",
          "type": "boolean"
        },
        "slots_available": {
          "title": "Slots Available",
          "type": "boolean"
        }
      },
      "required": [
        "rate_limit_ok",
        "cooldown_ok",
        "slots_available"
      ],
      "title": "DryRunPreconditions",
      "type": "object"
    },
    "DryRunResult": {
      "additionalProperties": false,
      "description": "The runner's preview of an action (RUN-007).",
      "properties": {
        "current": {
          "$ref": "#/$defs/DryRunCurrent"
        },
        "preconditions": {
          "$ref": "#/$defs/DryRunPreconditions"
        },
        "predicted_effect": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Predicted Effect",
          "type": "string"
        },
        "state_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Fingerprint",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "would_change": {
          "items": {
            "$ref": "#/$defs/WouldChange"
          },
          "title": "Would Change",
          "type": "array"
        }
      },
      "required": [
        "would_change",
        "current",
        "preconditions",
        "predicted_effect",
        "warnings",
        "state_fingerprint"
      ],
      "title": "DryRunResult",
      "type": "object"
    },
    "EvidenceAddedData": {
      "additionalProperties": false,
      "description": "An evidence item; ``payload`` is cut to 4 KB when needed, with ``payload_truncated``.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "detector_signal",
            "log_query",
            "metric_query",
            "deploy_list",
            "service_health",
            "runbook_hit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "Redacted content; one shape per kind (evidence_payload_<kind>.json)",
          "title": "Payload",
          "type": "object"
        },
        "payload_truncated": {
          "title": "Payload Truncated",
          "type": "boolean"
        },
        "purpose": {
          "enum": [
            "seed",
            "gather",
            "disproof"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "ref": {
          "pattern": "^E[0-9]{1,3}$",
          "title": "Ref",
          "type": "string"
        },
        "summary": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "suspicious_content": {
          "title": "Suspicious Content",
          "type": "boolean"
        },
        "tool_name": {
          "anyOf": [
            {
              "enum": [
                "query_logs",
                "query_metrics",
                "get_recent_deploys",
                "get_service_health",
                "search_runbooks"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null for seed evidence",
          "title": "Tool Name"
        }
      },
      "required": [
        "id",
        "ref",
        "kind",
        "purpose",
        "tool_name",
        "summary",
        "payload",
        "suspicious_content",
        "created_at",
        "payload_truncated"
      ],
      "title": "EvidenceAddedData",
      "type": "object"
    },
    "EvidenceAddedEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/EvidenceAddedData"
        },
        "event": {
          "const": "evidence.added",
          "title": "Event",
          "type": "string"
        },
        "event_id": {
          "pattern": "^[0-9]+-[0-9]+$",
          "title": "Event Id",
          "type": "string"
        },
        "incident_id": {
          "format": "uuid",
          "title": "Incident Id",
          "type": "string"
        },
        "state_version": {
          "description": "The incident's state_version after the change",
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "event",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "event_id",
        "incident_id",
        "state_version",
        "ts",
        "event",
        "data"
      ],
      "title": "EvidenceAddedEvent",
      "type": "object"
    },
    "ExecutionProgressData": {
      "additionalProperties": false,
      "properties": {
        "execution_id": {
          "format": "uuid",
          "title": "Execution Id",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "title": "Message",
          "type": "string"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "step": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "proposal_id",
        "step",
        "status",
        "message"
      ],
      "title": "ExecutionProgressData",
      "type": "object"
    },
    "ExecutionProgressEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/ExecutionProgressData"
        },
        "event": {
          "const": "execution.progress",
          "title": "Event",
          "type": "string"
        },
        "event_id": {
          "pattern": "^[0-9]+-[0-9]+$",
          "title": "Event Id",
          "type": "string"
        },
        "incident_id": {
          "format": "uuid",
          "title": "Incident Id",
          "type": "string"
        },
        "state_version": {
          "description": "The incident's state_version after the change",
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "event",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "event_id",
        "incident_id",
        "state_version",
        "ts",
        "event",
        "data"
      ],
      "title": "ExecutionProgressEvent",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "description": "A ranked root-cause hypothesis (§5.4, §5.5, §9.3; DB-004).",
      "properties": {
        "confidence": {
          "description": "After reflection (AI-016)",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_initial": {
          "description": "Before reflection",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence Initial",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^E[0-9]{1,3}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "rank": {
          "maximum": 3,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "reflection_notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reflection Notes"
        },
        "root_cause_category": {
          "enum": [
            "bad_deploy",
            "config_error",
            "memory_leak",
            "resource_saturation",
            "traffic_surge",
            "dependency_unavailable",
            "dependency_slow",
            "db_connection_exhaustion",
            "cache_failure",
            "application_bug",
            "network_issue",
            "disk_pressure",
            "unknown"
          ],
          "title": "Root Cause Category",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "dropped"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 400,
          "minLength": 10,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rank",
        "summary",
        "root_cause_category",
        "confidence",
        "confidence_initial",
        "evidence_refs",
        "status",
        "reflection_notes"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "HypothesisUpdatedData": {
      "additionalProperties": false,
      "description": "The full current set of hypotheses.",
      "properties": {
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "title": "Hypotheses",
          "type": "array"
        }
      },
      "required": [
        "hypotheses"
      ],
      "title": "HypothesisUpdatedData",
      "type": "object"
    },
    "HypothesisUpdatedEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/HypothesisUpdatedData"
        },
        "event": {

{
  "$defs": {
    "ContainerState": {
      "additionalProperties": false,
      "description": "State of one container (dry runs and structural health checks).",
      "properties": {
        "health": {
          "enum": [
            "healthy",
            "unhealthy",
            "starting",
            "none"
          ],
          "title": "Health",
          "type": "string"
        },
        "name": {
          "pattern": "^cs-[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "state": {
          "enum": [
            "created",
            "restarting",
            "running",
            "removing",
            "paused",
            "exited",
            "dead"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "name",
        "state",
        "health"
      ],
      "title": "ContainerState",
      "type": "object"
    },
    "DryRunCurrent": {
      "additionalProperties": false,
      "description": "What the runner sees now (§7.5).",
      "properties": {
        "active_release": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null for clear_cache",
          "title": "Active Release"
        },
        "cache_keys": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "clear_cache only",
          "title": "Cache Keys"
        },
        "containers": {
          "items": {
            "$ref": "#/$defs/ContainerState"
          },
          "title": "Containers",
          "type": "array"
        },
        "running_replicas": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "null for clear_cache",
          "title": "Running Replicas"
        }
      },
      "required": [
        "active_release",
        "running_replicas",
        "containers",
        "cache_keys"
      ],
      "title": "DryRunCurrent",
      "type": "object"
    },
    "DryRunPreconditions": {
      "additionalProperties": false,
      "properties": {
        "cooldown_ok": {
          "title": "Cooldown Ok",
          "type": "boolean"
        },
        "rate_limit_ok": {
          "title": "Rate Limit Ok",
          "type": "boolean"
        },
        "slots_available": {
          "title": "Slots Available",
          "type": "boolean"
        }
      },
      "required": [
        "rate_limit_ok",
        "cooldown_ok",
        "slots_available"
      ],
      "title": "DryRunPreconditions",
      "type": "object"
    },
    "DryRunResult": {
      "additionalProperties": false,
      "description": "The runner's preview of an action (RUN-007).",
      "properties": {
        "current": {
          "$ref": "#/$defs/DryRunCurrent"
        },
        "preconditions": {
          "$ref": "#/$defs/DryRunPreconditions"
        },
        "predicted_effect": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Predicted Effect",
          "type": "string"
        },
        "state_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Fingerprint",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "would_change": {
          "items": {
            "$ref": "#/$defs/WouldChange"
          },
          "title": "Would Change",
          "type": "array"
        }
      },
      "required": [
        "would_change",
        "current",
        "preconditions",
        "predicted_effect",
        "warnings",
        "state_fingerprint"
      ],
      "title": "DryRunResult",
      "type": "object"
    },
    "ProbeResult": {
      "additionalProperties": false,
      "description": "An HTTP ``/healthz`` probe.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency Ms"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Code"
        },
        "url": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "ok",
        "status_code",
        "latency_ms",
        "error"
      ],
      "title": "ProbeResult",
      "type": "object"
    },
    "RunnerHealthAfter": {
      "additionalProperties": false,
      "properties": {
        "structural": {
          "$ref": "#/$defs/StructuralHealth"
        }
      },
      "required": [
        "structural"
      ],
      "title": "RunnerHealthAfter",
      "type": "object"
    },
    "RunnerStep": {
      "additionalProperties": false,
      "description": "One execution step reported in a ``progress`` result (RUN-013).",
      "properties": {
        "message": {
          "maxLength": 300,
          "title": "Message",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "message"
      ],
      "title": "RunnerStep",
      "type": "object"
    },
    "StructuralHealth": {
      "additionalProperties": false,
      "description": "The runner's structural health check (RUN-014).",
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "containers": {
          "items": {
            "$ref": "#/$defs/ContainerState"
          },
          "title": "Containers",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "probes": {
          "items": {
            "$ref": "#/$defs/ProbeResult"
          },
          "title": "Probes",
          "type": "array"
        }
      },
      "required": [
        "passed",
        "checked_at",
        "containers",
        "probes"
      ],
      "title": "StructuralHealth",
      "type": "object"
    },
    "WouldChange": {
      "additionalProperties": false,
      "description": "One change an action would make: a container, or a cache for ``clear_cache``.",
      "properties": {
        "change": {
          "enum": [
            "start",
            "stop",
            "restart",
            "clear"
          ],
          "title": "Change",
          "type": "string"
        },
        "target": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "change"
      ],
      "title": "WouldChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A signed result on ``ocp:runner:results`` (§9.5).",
  "properties": {
    "captured": {
      "anyOf": [
        {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Captured"
    },
    "dry_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/DryRunResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "BAD_SIGNATURE",
            "REQUEST_EXPIRED",
            "ACTION_NOT_ALLOWED",
            "TARGET_NOT_ALLOWED",
            "VALIDATION_ERROR",
            "RATE_LIMITED",
            "COOLDOWN_ACTIVE",
            "STATE_DRIFT"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "execution_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Execution Id"
    },
    "health_after": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunnerHealthAfter"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "sig": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sig",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "refused",
        "succeeded",
        "failed",
        "aborted"
      ],
      "title": "Status",
      "type": "string"
    },
    "step": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunnerStep"
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "enum": [
        "dry_run_result",
        "progress",
        "execution_result"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "request_id",
    "execution_id",
    "status",
    "error_code",
    "dry_run",
    "step",
    "health_after",
    "captured",
    "ts",
    "sig"
  ],
  "title": "RunnerResult",
  "type": "object"
}

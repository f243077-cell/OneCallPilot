# OnCallPilot environment variables (CLAUDE.md §4.6, architecture.md §7.3).
# Every variable is listed here with a DUMMY value and a one-line comment,
# added in the same PR that introduces it. Real values live only in
# git-ignored .env.* files and infrastructure/secrets/. Never put a real
# secret in this file.

# socket-proxy-rw log level (info; debug only for the S0.7 spike). Used by: socket-proxy-rw
SOCKET_PROXY_RW_LOG_LEVEL=info

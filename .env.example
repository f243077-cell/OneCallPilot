# OnCallPilot environment variables (CLAUDE.md §4.6, architecture.md §7.3).
# Every variable is listed here with a DUMMY value and a one-line comment,
# added in the same PR that introduces it. Real values live only in
# git-ignored .env.* files and infrastructure/secrets/. Never put a real
# secret in this file.

# socket-proxy-rw log level (info; debug only for the S0.7 spike). Used by: socket-proxy-rw
SOCKET_PROXY_RW_LOG_LEVEL=info
# socket-proxy-ro log level (info; debug only for the S0.7 spike). Used by: socket-proxy-ro
SOCKET_PROXY_RO_LOG_LEVEL=info

# --- Chaos Shop testbed (infrastructure/compose/testbed.yml) ---
# Use long random hex values for the four secrets below (hex only: the two
# passwords are placed inside connection URLs). Example: python -c "import secrets; print(secrets.token_hex(24))"
# Password of the `shop` user in cs-postgres. Used by: cs-postgres, cs-api-*, cs-worker-*
CS_POSTGRES_PASSWORD=0000000000000000000000000000000000000000000000aa
# Password of cs-redis (the runner never gets it). Used by: cs-redis, cs-api-*, cs-worker-*
CS_REDIS_PASSWORD=0000000000000000000000000000000000000000000000bb
# Bearer token for the testbed /internal/* control endpoints. Used by: chaos CLI, cs-payments, cs-loadgen
CHAOS_TOKEN=0000000000000000000000000000000000000000000000cc
# Bearer token for cs-api /internal/cache/* (clear_cache). Used by: runner, cs-api-*
RUNNER_ADMIN_TOKEN=0000000000000000000000000000000000000000000000dd
#
# Set inside testbed.yml, not in .env (listed here for completeness):
#   CS_RELEASE (baked into each image), CS_INSTANCE (container name),
#   CS_DATABASE_URL, CS_REDIS_URL, CS_PAYMENTS_URL (cs-api, cs-worker),
#   QUEUE_BATCH_SIZE (cs-worker, 1-100), CS_RELEASES_FILE (default releases.yaml),
#   CS_LOADGEN_TARGET_URL, CS_LOADGEN_BASELINE_RPS, CS_LOADGEN_SPIKE_RPS,
#   CS_LOADGEN_RAMP_SECONDS (cs-loadgen).
